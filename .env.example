# Copy to .env and adjust for your host before running docker compose.
MCP_FILE_TOOLS_HOST=127.0.0.1
MCP_FILE_TOOLS_PORT=8787
MCP_FILE_TOOLS_VERSION=dev

# Mount the host workspace the MCP server should be able to read and write.
# Refactor tools write through MCP_HOST_WORKSPACE; MCP_HOST_HOME stays read-only
# in docker-compose.yml for path lookup convenience.
MCP_HOST_WORKSPACE=.
MCP_CONTAINER_WORKSPACE=/workspace
MCP_HOST_HOME=.
MCP_CONTAINER_HOME=/host-home

# Optional same-OS absolute path alias mapping in source=target form.
# source is the input/display alias; target is the real server path.
# Cross-OS host/container mappings are ignored: tool inputs must use paths as
# seen by the OS where the MCP server runs, for example /workspace in Docker.
# Example: MCP_PATH_MAPS=/repo-alias=/workspace
MCP_PATH_MAPS=

# Docker Compose keeps cwd_id allocator metadata in a persistent named volume.
# Use an absolute container-local path.
MCP_CWD_STATE_PATH=/state/cwd-state.sqlite
